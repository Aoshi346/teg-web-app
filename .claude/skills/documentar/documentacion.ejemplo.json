      "papel": "#F7F6F2", "papel2": "#ECEAE3", "tinta": "#1F2430", "suave": "#565E6E",
      "linea": "#D6D3CA", "acento": "#1F5F99", "acento_vivo": "#5AA9E6", "piel": "#E6EEF5"
    },
    "fuentes": {
      "display": { "familia": "Georgia, serif" },
      "cuerpo": { "familia": "Inter, system-ui, sans-serif",
                  "ficheros": [{ "peso": 400, "ruta": "frontend/public/fonts/Inter-400.woff2" }] },
      "mono": { "familia": "ui-monospace, monospace" }
    }
  }
