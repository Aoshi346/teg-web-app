# TesisFar backend — production environment
# Copy to backend/.env and fill in real values. Do NOT commit backend/.env.
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=tesisfar.elevaiti.com
CSRF_TRUSTED_ORIGINS=https://tesisfar.elevaiti.com
CORS_ALLOWED_ORIGINS=https://tesisfar.elevaiti.com
# Flip to True only after TLS is live, otherwise login cookies break over HTTP.
SECURE_COOKIES=False
