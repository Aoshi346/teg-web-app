[Unit]
Description=TesisFar backend (Django + gunicorn en 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@BASE@/current/backend
EnvironmentFile=@BASE@/tesisfar.env
ExecStart=@BASE@/current/backend/.venv/bin/gunicorn core.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
